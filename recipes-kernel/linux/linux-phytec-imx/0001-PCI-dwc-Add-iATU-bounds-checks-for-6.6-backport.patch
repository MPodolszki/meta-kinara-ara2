From e03035c9c4e1429b0944e30ae837490eb552f743 Mon Sep 17 00:00:00 2001
From: m.podolszki@phytec.de
Date: Wed, 15 Apr 2026 14:24:56 +0200
Subject: [PATCH 1/2] PCI: dwc: Add iATU bounds checks for 6.6 backport

---
 drivers/pci/controller/dwc/pcie-designware.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/pci/controller/dwc/pcie-designware.c b/drivers/pci/controller/dwc/pcie-designware.c
index 2b60d20df..72568fdb2 100644
--- a/drivers/pci/controller/dwc/pcie-designware.c
+++ b/drivers/pci/controller/dwc/pcie-designware.c
@@ -471,6 +471,9 @@ static int __dw_pcie_prog_outbound_atu(struct dw_pcie *pci, u8 func_no,
 	u32 retries, val;
 	u64 limit_addr;
 
+	if (index >= pci->num_ob_windows)
+		return -ENOSPC;
+
 	if (pci->ops && pci->ops->cpu_addr_fixup)
 		cpu_addr = pci->ops->cpu_addr_fixup(pci, cpu_addr);
 
@@ -557,6 +560,9 @@ int dw_pcie_prog_inbound_atu(struct dw_pcie *pci, int index, int type,
 	u64 limit_addr = pci_addr + size - 1;
 	u32 retries, val;
 
+	if (index >= pci->num_ib_windows)
+		return -ENOSPC;
+
 	if ((limit_addr & ~pci->region_limit) != (pci_addr & ~pci->region_limit) ||
 	    !IS_ALIGNED(cpu_addr, pci->region_align) ||
 	    !IS_ALIGNED(pci_addr, pci->region_align) || !size) {
-- 
