set -e

# Get the mmcblk where root filesystem is mounted
DEVICE=$(findmnt -n -o SOURCE / | sed -E 's|(/dev/mmcblk[0-9]+)p[0-9]+|\1|')
PARTITION="${DEVICE}p2"

# Get start sector
START_SECTOR=$(fdisk -l $DEVICE | awk -v part="$PARTITION" '$1 == part {print $2}')

echo "Starting fdisk..."

fdisk "$DEVICE" >/dev/null 2>&1 <<EOF
d
2
n
p
2
$START_SECTOR

N
w
EOF

echo "Informing kernel of partition changes..."
partprobe $DEVICE

sync

echo "Resizing filesystem..."
resize2fs "$PARTITION"

echo "Partition and filesystem resized."
