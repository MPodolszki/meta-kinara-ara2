import subprocess
import sys

if __name__ == "__main__":
    cmd = [
        "uvx",
        "--no-cache",
        "-qq",
        "--from",
        "/usr/share/python-wheels/fetch_models-1.0.0-py3-none-any.whl",
        "fetch_models"
    ] + sys.argv[1:]
    
    try:
        subprocess.run(cmd)
    except FileNotFoundError:
        print("Please be sure you have 'uv' and 'uvx' install")

